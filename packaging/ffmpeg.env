# FFmpeg builds bundled with the installers (GPL v3), pinned by SHA-256.
# Sourced by scripts/build-windows-installer.sh, scripts/bundle-macos.sh and
# .github/workflows/release.yml. When updating a build, change its URL,
# SHA-256, version and source together.

# Windows x64: BtbN FFmpeg-Builds, static GPL 9.0. Monthly build (the last
# build of each month is kept for two years).
FFMPEG_WIN_URL=https://github.com/FFmpeg-Builds/FFmpeg-Builds/releases/download/autobuild-2026-10-31-12-59/ffmpeg-n9.0.2-39-g7adfbe40dc-win64-gpl-9.0.zip
FFMPEG_WIN_SHA256=693f3e224bc184b40524a62ca47526cfebaf2504414021b92fe75f677ad868b9
FFMPEG_WIN_VERSION=n9.0.2-39-g7adfbe40dc
FFMPEG_WIN_BUILD=https://github.com/FFmpeg-Builds/FFmpeg-Builds/tree/autobuild-2026-10-31-12-59
# FFmpeg source at the exact commit of the build. GitHub-generated archive,
# so not pinned by SHA-256; the commit identifies it.
FFMPEG_WIN_SOURCE_URL=https://github.com/FFmpeg/FFmpeg/archive/7adfbe40dcde598f93a6963d2f7b22cd75202ccc.tar.gz

# macOS arm64: Martin Riedl's FFmpeg Build Server, release 9.0.2 (static,
# GPL v3, signed). Build script: https://git.martin-riedl.de/ffmpeg/build-script
FFMPEG_MAC_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/ffmpeg.zip
FFMPEG_MAC_SHA256=c8ed4c4e6978a03c485edbfe4e0a5dc2380f8a30bba5150531b31b094492d924
FFMPEG_MAC_VERSION=9.0.2
FFMPEG_MAC_BUILD=https://git.martin-riedl.de/ffmpeg/build-script
FFMPEG_MAC_SOURCE_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_MAC_SOURCE_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
