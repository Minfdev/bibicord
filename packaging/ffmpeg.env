# Sources of the FFmpeg build bundled with the installers (GPL v3), pinned by
# SHA-256. Used by scripts/build-ffmpeg.sh (build), scripts/ffmpeg-source.sh
# (source archive attached to every release) and scripts/ffmpeg-notice.sh.
# When updating a component, change its version, URL and SHA-256 together.

FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e

# x264, branch "stable". GitLab-generated archive of the commit: if its
# SHA-256 ever changes upstream, compare the contents and update the sum.
X264_VERSION=stable-b35605ace3dd
X264_URL=https://code.videolan.org/videolan/x264/-/archive/b35605ace3ddf7c1a5d67a2eb553f034aef41d55/x264-b35605ace3ddf7c1a5d67a2eb553f034aef41d55.tar.bz2
X264_SHA256=6eeb82934e69fd51e043bd8c5b0d152839638d1ce7aa4eea65a3fedcf83ff224

X265_VERSION=4.2
X265_URL=https://download.videolan.org/pub/videolan/x265/x265_4.2.tar.gz
X265_SHA256=40b1ea0453e0309f0eba934e0ddf533f8f6295966679e8894e8f1c1c8d5e1210

# Windows only: headers for NVENC/NVDEC and AMD AMF (drivers are loaded at
# runtime). 12.2 keeps NVENC working with NVIDIA drivers 550 and newer.
NVCODEC_VERSION=12.2.72.0
NVCODEC_URL=https://github.com/FFmpeg/nv-codec-headers/releases/download/n12.2.72.0/nv-codec-headers-12.2.72.0.tar.gz
NVCODEC_SHA256=c295a2ba8a06434d4bdc5c2208f8a825285210d71d91d572329b2c51fd0d4d03

AMF_VERSION=1.5.3
AMF_URL=https://github.com/GPUOpen-LibrariesAndSDKs/AMF/releases/download/v1.5.3/AMF-headers-v1.5.3.tar.gz
AMF_SHA256=0f521ad98041f8001147cded4a660127f18b1c27a801a5cd691bda1fa48381be

FFMPEG_COMPONENTS="FFMPEG X264 X265 NVCODEC AMF"
